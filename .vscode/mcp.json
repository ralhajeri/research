{
    "inputs": [
        {
            "type": "promptString",
            "id": "tavily_api_key",
            "description": "Tavily API Key",
            "password": true
        },
        {
            "id": "CONTEXT7_API_KEY",
            "type": "promptString",
            "description": "API key for authentication",
            "password": true
        }
    ],
    "servers": {
        "Figma": {
            "type": "http",
            "url": "https://mcp.figma.com/mcp",
            "gallery": "https://api.mcp.github.com/2025-09-15/v0/servers/26cb5bb7-a100-4f25-9a92-086ba4037345",
        },
        "Playwright": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ],
            "gallery": "https://api.mcp.github.com",
            "version": "0.0.1-seed",
        },
        "MicrosoftDocs": {
            "type": "http",
            "url": "https://learn.microsoft.com/api/mcp",
            "gallery": "https://api.mcp.github.com",
            "version": "1.0.0",
        },
        "CopilotKit": {
            "url": "https://mcp.copilotkit.ai/mcp",
        },
        "tavily": {
            "command": "npx",
            "args": [
                "-y",
                "tavily-mcp@latest"
            ],
            "env": {
                "TAVILY_API_KEY": "${input:tavily_api_key}"
            }
        },
        "io.github.upstash/context7": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "@upstash/context7-mcp@1.0.31"
            ],
            "env": {
                "CONTEXT7_API_KEY": "${input:CONTEXT7_API_KEY}"
            },
            "gallery": "https://api.mcp.github.com",
            "version": "1.0.31"
        }
    }
}